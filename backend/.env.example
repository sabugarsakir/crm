# JWT Secret key for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fcp_lead_soft

# Nodemailer Email Configuration (for automated CP verification & password dispatch)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# CORS Allowed Origin for Frontend Client
ALLOWEDORIGINS=http://localhost:5173
PORT=3000
